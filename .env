# ==========================================================================
# Exemple de configuration — copier ce fichier en ".env" à la racine de
# banque_app/ et adapter les valeurs à votre environnement local.
# ==========================================================================

# --- Sécurité Django ---
DJANGO_SECRET_KEY=changez-moi-avec-une-cle-secrete-longue-et-aleatoire
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de données ---
# DB_ENGINE=sqlite   -> fonctionne immédiatement, sans installation supplémentaire (recommandé pour démarrer / tester)
# DB_ENGINE=mysql    -> utilise le serveur MySQL décrit ci-dessous (recommandé pour la soutenance / la stack imposée)
DB_ENGINE=sqlite
DB_NAME=banque_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Sécurité applicative ---
LOGIN_MAX_TENTATIVES=5
LOGIN_BLOCAGE_MINUTES=5

# --- Plafonds de transaction par défaut (FCFA) ---
PLAFOND_JOURNALIER_DEFAUT=1000000
PLAFOND_MENSUEL_DEFAUT=10000000

# --- Micro-service de paiement mobile (FastAPI, SIMULATION) ---
PAIEMENT_MOBILE_API_URL=http://127.0.0.1:8001
PAIEMENT_MOBILE_API_TIMEOUT=5
# Secret interne partagé avec paiement_mobile_api/.env (doit être identique).
# La valeur par défaut n'est admise qu'en démonstration locale : générez un
# secret aléatoire long avant toute mise en ligne.
PAIEMENT_MOBILE_API_SECRET=demo-interne-a-changer-en-production

# --- Messagerie applicative (réinitialisation de mot de passe) ---
# console = affiche l'e-mail dans la console (développement)
# file    = écrit un fichier .eml dans banque_app/emails_dev/ (développement)
# smtp    = envoi réel via un serveur SMTP (production) ; renseigner alors
#           EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD,
#           EMAIL_USE_TLS et DEFAULT_FROM_EMAIL.
EMAIL_BACKEND_MODE=file
DEFAULT_FROM_EMAIL=no-reply@ma-banque.local
